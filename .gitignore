# runtime state — written by the shell, personal to each install
lucidbar/blur.json
lucidbar/clock_reminders.json
lucidbar/mpris_shazam.json
luciddocks/pinned.json
luciddocks/usage.json
luciddocks/wallpaper.json
lucidmoji/config.json
lucidmoji/state.json
lucidkeys/state.json
lucidprefs/prefs.json
lucidwidgets/widgets.json

# editor / tooling
.claude/
*.qmlc
*.jsc

# screenshot originals — the committed .webp versions are what the README uses
assets/*.png

# python bytecode from the emoji reader
__pycache__/

# generated on demand from each theme's own dark palette
support/lucid/themes/*/quickshell-light.json

# the login screen's wallpaper, blurred from whatever the desktop is using
support/sddm/lucid/background.jpg
